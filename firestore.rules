rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

	// Nota: el nombre de la colección va SIN llaves. Con llaves ({datosUsuarios})
	// se convierte en comodín y la regla aplica a TODAS las colecciones.

	match /datosUsuarios/{document=**}{
		allow read:if true;
		// Práctica 1: al crear se exigen la fecha de creación y la de último acceso
		allow create: if request.resource.data.idemp is string &&
						 request.resource.data.usuario is string &&
						 request.resource.data.email is string &&
						 request.resource.data.fechaCreacion is timestamp &&
						 request.resource.data.ultAcceso is timestamp;
		// Práctica 1: un usuario autenticado solo puede actualizar la fecha de último acceso
		allow update: if request.auth != null &&
						 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultAcceso']) &&
						 request.resource.data.ultAcceso is timestamp;
		allow delete: if false;
	}

	match /datosZodiaco/{document=**}{
		allow read:if true;
		// Práctica 2: se validan los nuevos campos del signo
		allow create: if request.auth != null && signoValido();
		// Práctica 4: se permite modificar un signo con los mismos datos válidos
		allow update: if request.auth != null && signoValido();
		allow delete: if false;
	}

	function signoValido() {
		return request.resource.data.posic is int &&
			   request.resource.data.signo is string &&
			   request.resource.data.rango is string &&
			   request.resource.data.elemento in ['Fuego', 'Tierra', 'Aire', 'Agua'] &&
			   request.resource.data.astro is string &&
			   request.resource.data.piedra is string &&
			   request.resource.data.url is string;
	}

  }
}
